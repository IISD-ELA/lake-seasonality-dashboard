{
  "name": "ELA Seasonality Dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/seasonality_app/handler.py",
        "web/index.html"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt -r requirements-dev.txt",
  "portsAttributes": {
    "8080": {
      "label": "AWS dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8080
  ]
}
